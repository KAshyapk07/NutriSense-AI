{
  "name": "nutrisense-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop": "electron ./electron/main.cjs",
    "postinstall": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.4",
    "@ricky0123/vad-web": "^0.0.22",
    "clsx": "^2.1.1",
    "firebase": "^11.10.0",
    "framer-motion": "^11.15.0",
    "keytar": "^7.9.0",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/node": "^22.19.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.0.0"
  },
  "build": {
    "appId": "com.nutrisense.app",
    "productName": "NutriSense AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../icon/App_icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "protocols": {
      "name": "nutrisense",
      "schemes": [
        "nutrisense"
      ]
    }
  }
}
